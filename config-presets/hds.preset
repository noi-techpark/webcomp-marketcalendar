# Preset: HDS — aspect values (colors, logos, map indicators).
# Use this preset to apply these values instead of defining them in .config.

###########
# ASPECTS
###########

PRIMARY_COLOR_DARK= #007BFF
SECONDARY_COLOR_DARK= #000000
PRIMARY_COLOR_LIGHT= #007BFF
SECONDARY_COLOR_LIGHT= #ffffff

BACKGROUND_COLOR_DARK= #171717
CARD_BACKGROUND_COLOR_DARK= #000000
TEXT_COLOR_DARK= #FFFFFF
BORDER_COLOR_DARK= transparent
INPUT_BORDER_COLOR_DARK= #FFFFFF

BACKGROUND_COLOR_LIGHT= #f0f0f0
CARD_BACKGROUND_COLOR_LIGHT= #ffffff
TEXT_COLOR_LIGHT= #000000
BORDER_COLOR_LIGHT= transparent
INPUT_BORDER_COLOR_LIGHT= #000000

LOGO_LIGHT= src/app/logo/hds_logo_dark.svg
LOGO_DARK= src/app/logo/hds_logo_light.svg

COLOR_INDICATOR_POSITION_FAIRS_MAP= #024c96
COLOR_INDICATOR_POSITION_MARKETS_MAP= #F39650
