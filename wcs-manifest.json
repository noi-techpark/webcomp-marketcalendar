{
  "title": "Market Calendar",
  "shortName": "webcomp-market-calendar",
  "description": "Responsive market & fairs calendar (markets + year markets) with list, detail, map and community aggregation views.",
  "descriptionAbstract": "Markets & fairs calendar (ODH Tourism API) with lists, details, map and community aggregation.",
