      "organization": "NOI S.p.A",
      "organizationUrl": "https://noi.bz.it"
    }
  ],
  "image": "wcs-logo.png",
  "searchTags": [],
  "dist": {
    "basePath": "dist",
    "files": [
      "webcomp-market-calendar.js"
    ],
    "scripts": [
    ]
  },
  "configuration": {
    "tagName": "webcomp-market-calendar",
    "options": [
      {
        "key": "language",
        "type": "select",
        "label": "language",
        "required": false,
        "options": { "values": ["en", "it", "de"], "default": "en" }
      },
      {
        "key": "theme",
        "type": "select",
        "label": "theme",
        "required": false,
        "options": { "values": ["light", "dark"], "default": "light" }
      },
      {
        "key": "initial-view",
        "type": "select",
        "label": "initial-view",
        "required": false,
        "options": { "values": ["markets", "fairs", "map", "community"], "default": "markets" }
      },
      {
        "key": "api-base",
        "type": "text",
        "label": "api-base",
        "required": false,
        "options": { "default": "https://tourism.api.opendatahub.testingmachine.eu" }
      },
      {
        "key": "page-size",
        "type": "number",
        "label": "page-size",
        "required": false,
        "options": { "default": 20, "min": 1, "max": 200, "step": 1 }
      },
      {
        "key": "debug",
        "type": "bool",
        "label": "debug",
        "required": false,
        "options": { "default": false }
      }
    ]
  }
}
